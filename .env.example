# Optional: Cesium ion token for 3D world terrain (https://ion.cesium.com/tokens). Without it the globe is a smooth ellipsoid.
VITE_CESIUM_TOKEN=
# Optional: NASA FIRMS map key for fire hotspots (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Server-side only.
FIRMS_MAP_KEY=
# Optional: OpenWeatherMap key for the weather layers (https://home.openweathermap.org/api_keys). Server-side only.
OPENWEATHER_API_KEY=
